<template>
<div class="screen {{ motionClass }}" @swipe="handleSwipe" @touchstart="touchStart" @touchmove="touchMove" @touchend="touchEnd"><scroll class="content" scroll-y="true"><div class="stack">
<div class="header"><div class="back" onclick="goBack"><text class="backText">‹</text></div><text class="title">设置</text></div><div class="row" onclick="toggleHaptics"><div class="copy"><text class="rowTitle">触感反馈</text><text class="rowHint">点按时短震</text></div><div class="toggle {{ vm.haptics ? 'toggleOn' : '' }}"><div class="toggleKnob"></div></div></div><div class="row" onclick="toggleReducedMotion"><div class="copy"><text class="rowTitle">减少动画</text><text class="rowHint">关闭页面移动</text></div><div class="toggle {{ vm.reducedMotion ? 'toggleOn' : '' }}"><div class="toggleKnob"></div></div></div><div class="row" onclick="profile"><div class="copy"><text class="rowTitle">账户与设备</text><text class="rowHint">查看手机同步状态</text></div><text class="chevron">›</text></div><text class="sourceLine">{{ vm.sourceShort }}</text><div class="layers"><div class="layer"><text class="layerName">手机互联</text><text class="layerState">{{ vm.phoneLabel }}</text></div><div class="layer"><text class="layerName">Orialis</text><text class="layerState">{{ vm.orialisLabel }}</text></div><div class="layer"><text class="layerName">目标设备</text><text class="layerState">{{ vm.targetLabel }}</text></div></div><text class="meta">{{ vm.connectionStatus }}</text><text class="label">本地显示</text><div class="row" onclick="toggleCompact"><div class="glyphCircle slate"><div class="glyph menuGlyph"><div class="menuLine"></div></div></div><div class="copy"><text class="rowTitle">紧凑列表</text><text class="rowHint">减少列表备注</text></div><div class="toggle {{ vm.compact ? 'toggleOn' : '' }}"><div class="toggleKnob"></div></div></div><div class="row" onclick="toggleDemo"><div class="glyphCircle blue"><div class="glyph commandGlyph"><div class="commandLine"></div><div class="commandLineLow"></div></div></div><div class="copy"><text class="rowTitle">演示数据</text><text class="rowHint">本地预览 · 重启后关闭</text></div><div class="toggle {{ vm.demo ? 'toggleOn' : '' }}"><div class="toggleKnob"></div></div></div><div class="row" onclick="diagnostics"><div class="glyphCircle teal"><div class="glyph deviceGlyph"><div class="deviceStand"></div></div></div><div class="copy"><text class="rowTitle">连接诊断</text><text class="rowHint">检查手机连接</text></div><text class="chevron">›</text></div><div class="block"><text class="label">快照缓存</text><text class="body">{{ vm.snapshotSummary }}</text><text class="meta">{{ vm.syncLabel }}</text><text class="provenance">{{ vm.provenance }}</text><text class="meta">{{ vm.scopeLabel }}</text><div class="button" onclick="clearCache"><text class="buttonText">清除本地快照</text></div><text class="hint">右滑返回功能菜单</text></div>
</div></scroll></div>
</template>
<script>
const pages = require('../../services/page')
export default pages.createPage('settings')
</script>
<style>
@import "../../common/wear.css";
</style>
