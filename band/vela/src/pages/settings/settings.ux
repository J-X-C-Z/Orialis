<template>
<div class="screen {{ motionClass }}" @swipe="handleSwipe" @touchstart="touchStart" @touchmove="touchMove" @touchend="touchEnd">
<scroll class="content" scroll-y="true"><div class="stack">
<div class="header"><div class="back" onclick="goBack"><text class="backText">‹</text></div><text class="title">设置</text></div>
<text class="sectionTitle">触感与显示</text>
<div class="row" onclick="toggleHaptics"><div class="settingCopy"><text class="settingTitle">触感反馈</text><text class="settingHint">点按时短震</text></div><div class="toggle {{ vm.haptics ? 'toggleOn' : '' }}"><div class="toggleKnob"></div></div></div>
<div class="row" onclick="toggleReducedMotion"><div class="settingCopy"><text class="settingTitle">减少动画</text><text class="settingHint">关闭页面移动</text></div><div class="toggle {{ vm.reducedMotion ? 'toggleOn' : '' }}"><div class="toggleKnob"></div></div></div>
<div class="row" onclick="toggleCompact"><div class="settingCopy"><text class="settingTitle">紧凑列表</text><text class="settingHint">减少列表备注</text></div><div class="toggle {{ vm.compact ? 'toggleOn' : '' }}"><div class="toggleKnob"></div></div></div>
<text class="sectionTitle">账户与连接</text>
<div class="row" onclick="profile"><div class="settingCopy"><text class="settingTitle">账户与设备</text><text class="settingHint">查看手机同步状态</text></div><text class="chevron">›</text></div>
<div class="statusCard"><text class="sectionTitle">连接状态</text><div class="layer"><text class="layerName">手机互联</text><text class="layerState">{{ vm.phoneLabel }}</text></div><div class="layer"><text class="layerName">Orialis</text><text class="layerState">{{ vm.orialisLabel }}</text></div><div class="layer"><text class="layerName">目标设备</text><text class="layerState">{{ vm.targetLabel }}</text></div><text class="caption">{{ vm.connectionStatus }}</text><text class="caption">{{ vm.sourceShort }}</text></div>
<div class="row" onclick="diagnostics"><div class="settingCopy"><text class="settingTitle">连接诊断</text><text class="settingHint">检查手机连接与回应</text></div><text class="chevron">›</text></div>
<text class="sectionTitle">预览与本地数据</text>
<div class="row" onclick="toggleDemo"><div class="settingCopy"><text class="settingTitle">演示数据</text><text class="settingHint">本地预览 · 重启后关闭</text></div><div class="toggle {{ vm.demo ? 'toggleOn' : '' }}"><div class="toggleKnob"></div></div></div>
<div class="statusCard"><text class="sectionTitle">快照缓存</text><text class="detailBody">{{ vm.snapshotSummary }}</text><text class="caption">{{ vm.syncLabel }}</text><text class="caption">{{ vm.provenance }}</text><text class="caption">任务详情可勾选完成；其他编辑请在手机完成。</text></div>
<div class="dangerButton" onclick="clearCache"><text class="buttonText">清除本地快照</text></div>
<text class="footerNote">清除手环缓存不会删除手机记录。</text>
<text class="footerNote">右滑返回上一层</text>
</div></scroll></div>
</template>
<script>
const pages = require('../../services/page')
export default pages.createPage('settings')
</script>
<style>
@import "../../common/wear.css";
</style>
