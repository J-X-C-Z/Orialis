<template>
<div class="screen {{ motionClass }}" @swipe="handleSwipe" @touchstart="touchStart" @touchmove="touchMove" @touchend="touchEnd"><scroll class="content" scroll-y="true"><div class="stack">
<div class="header"><div class="back" if="{{ selection || homeSection }}" onclick="goBack"><text class="backText">‹</text></div><text class="title">{{ selection ? '详情' : homeSection ? sectionTitle : '今日' }}</text><text class="source">{{ vm.sourceShort }}</text></div><div class="stack glanceStack" if="{{ !selection && !homeSection }}">
<div class="glanceCard" for="{{ organizer.cards }}" onclick="openSection($item.key)"><div class="glanceAccent {{ $item.tone }}"></div><div class="copy"><div class="glanceHeading"><text class="glanceLabel">{{ $item.label }}</text><text class="glanceCount">{{ $item.countLabel }}</text></div><text class="glanceValue">{{ $item.preview }}</text></div></div>
<div class="glanceFooter" onclick="menu"><text class="hintText">{{ organizer.partial ? '部分快照 · ' : '' }}左滑打开菜单</text><text class="chevron">›</text></div></div>
<div class="stack" if="{{ homeSection && !selection }}"><text class="emptyBody" if="{{ !visibleRows.length }}">{{ organizer.available ? '暂无内容' : '请先在手机连接并同步' }}</text><div class="row" for="{{ visibleRows }}" onclick="openItem($item.kind, $item.id)"><div class="copy"><text class="rowTitle">{{ $item.title }}</text><text class="rowHint">{{ $item.subtitle }}</text></div><text class="chevron">›</text></div><div class="disabled" if="{{ hasMore }}" onclick="showMore"><text class="buttonText">显示更多</text></div></div><div class="stack" if="{{ selection && organizer.detail }}"><div class="card"><text class="taskName">{{ organizer.detail.displayTitle }}</text><text class="stateBadge">{{ organizer.detail.statusLabel }}</text><text class="meta" if="{{ organizer.detail.due }}">截止 {{ organizer.detail.due }}</text><text class="emptyBody" if="{{ organizer.detail.notes }}">{{ organizer.detail.notes }}</text><text class="emptyBody" if="{{ organizer.detail.description }}">{{ organizer.detail.description }}</text><text class="emptyBody" if="{{ organizer.detail.goal }}">{{ organizer.detail.goal }}</text><text class="meta" if="{{ organizer.detail.when }}">{{ organizer.detail.when }}</text><text class="meta" if="{{ organizer.detail.location }}">{{ organizer.detail.location }}</text><text class="meta" if="{{ organizer.detail.kind === 'tasks' || organizer.detail.kind === 'schedules' }}">提前提醒 {{ organizer.detail.reminderMinutes === null || organizer.detail.reminderMinutes === undefined ? '未设置' : organizer.detail.reminderMinutes + '分钟' }}</text><text class="meta" if="{{ organizer.detail.kind === 'tasks' || organizer.detail.kind === 'schedules' }}">通知送达待接入</text><text class="meta" if="{{ organizer.detail.recurrence }}">已有重复规则 · 在手机编辑</text><text class="meta" if="{{ organizer.detail.kind === 'projects' }}">里程碑 {{ organizer.detail.progress }}</text><text class="body" if="{{ organizer.detail.kind === 'projects' }}">下一步 {{ organizer.detail.next }}</text></div>


<text class="label" if="{{ organizer.detail.kind === 'projects' }}">里程碑</text><div class="row {{ $item.completed ? 'selected' : '' }}" for="{{ organizer.milestones }}" onclick="openItem($item.kind, $item.id)"><div class="glyphCircle teal"><div class="check"></div></div><div class="copy"><text class="rowTitle">{{ $item.title }}</text><text class="rowHint">{{ $item.subtitle }}</text></div><text class="chevron">›</text></div><text class="label" if="{{ organizer.detail.kind === 'tasks' || organizer.detail.kind === 'schedules' || organizer.detail.kind === 'projects' }}">{{ organizer.detail.kind === 'tasks' ? '一级子任务' : '关联任务' }}</text><div class="row {{ $item.completed ? 'selected' : '' }}" for="{{ organizer.related }}" onclick="openItem($item.kind, $item.id)"><div class="glyphCircle teal"><div class="check"></div></div><div class="copy"><text class="rowTitle">{{ $item.title }}</text><text class="rowHint">{{ $item.subtitle }}</text></div><text class="chevron">›</text></div>
<div class="disabled" onclick="closeDetail"><text class="buttonText">返回列表</text></div></div><div class="block" if="{{ selection || homeSection }}"><text class="provenance">{{ vm.provenance }}</text><text class="meta">{{ vm.syncLabel }}</text><text class="notice" if="{{ organizer.partial }}">部分数据 · 完整记录请在手机查看</text></div>
</div></scroll></div>
</template>
<script>
const pages = require('../../services/page')
export default pages.createPage('home')
</script>
<style>
@import "../../common/wear.css";
</style>
