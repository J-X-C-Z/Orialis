<template>
  <div class="screen {{ motionClass }}" @swipe="handleSwipe" @touchstart="touchStart" @touchmove="touchMove" @touchend="touchEnd">
    <scroll class="content" scroll-y="true">
      <div class="stack">
        <div class="header">
          <div class="back" onclick="goBack">
            <text class="backText">‹</text>
          </div>
          <text class="title">{{ selection ? '详情' : pageTitle }}</text>
          <text class="source">{{ vm.sourceShort }}</text>
        </div>
        <text if="{{ notice }}" class="notice">{{ notice }}</text>
        <div class="stack" if="{{ !selection }}">
          <div class="emptyCard" if="{{ !organizer.rows.length }}">
            <div class="emptyIcon">
              <div class="glyph folderGlyph">
                <div class="folderInner"></div>
              </div>
            </div>
            <text class="emptyTitle">{{ organizer.available ? (organizer.partial ? '已同步内容暂无项目' : '暂无项目') : '等待手机同步' }}</text>
            <text class="emptyBody">在手机打开 Orialis，同步后查看项目与里程碑。</text>
          </div>
          <div class="row {{ vm.compact ? 'compactRow' : '' }} {{ $item.completed ? 'selected' : '' }}" for="{{ visibleRows }}" onclick="openItem($item.kind, $item.id)">
            <div class="glyphCircle orange">
              <div class="glyph folderGlyph">
                <div class="folderInner"></div>
              </div>
            </div>
            <div class="copy">
              <text class="rowTitle">{{ $item.title }}</text>
              <text class="rowHint" if="{{ !vm.compact }}">{{ $item.subtitle }}</text>
            </div>
            <text class="chevron">›</text>
          </div>
        </div>
        <div class="secondaryButton" if="{{ !selection && hasMore }}" onclick="showMore">
          <text class="buttonText">显示更多</text>
        </div>
        <div class="stack" if="{{ selection && organizer.detail }}">
          <div class="statusCard">
            <text class="detailTitle">{{ organizer.detail.displayTitle }}</text>
            <text class="stateBadge">{{ organizer.detail.statusLabel }}</text>
            <text class="caption" if="{{ organizer.detail.due }}">截止 {{ organizer.detail.due }}</text>
            <text class="sectionTitle" if="{{ organizer.detail.notes }}">备注</text>
            <text class="detailBody" if="{{ organizer.detail.notes }}">{{ organizer.detail.notes }}</text>
            <text class="sectionTitle" if="{{ organizer.detail.description }}">说明</text>
            <text class="detailBody" if="{{ organizer.detail.description }}">{{ organizer.detail.description }}</text>
            <text class="sectionTitle" if="{{ organizer.detail.goal }}">目标</text>
            <text class="detailBody" if="{{ organizer.detail.goal }}">{{ organizer.detail.goal }}</text>
            <text class="sectionTitle" if="{{ organizer.detail.when }}">时间</text>
            <text class="detailBody" if="{{ organizer.detail.when }}">{{ organizer.detail.when }}</text>
            <text class="sectionTitle" if="{{ organizer.detail.location }}">地点</text>
            <text class="detailBody" if="{{ organizer.detail.location }}">{{ organizer.detail.location }}</text>
            <text class="caption" if="{{ organizer.detail.kind === 'tasks' || organizer.detail.kind === 'schedules' }}">提前提醒 {{ organizer.detail.reminderMinutes === null || organizer.detail.reminderMinutes === undefined ? '未设置' : organizer.detail.reminderMinutes + '分钟' }}</text>
            <text class="caption" if="{{ organizer.detail.kind === 'tasks' || organizer.detail.kind === 'schedules' }}">提醒由手机通知发出；请在小米运动健康开启 Orialis 通知显示</text>
            <text class="caption" if="{{ organizer.detail.recurrence }}">已有重复规则 · 在手机编辑</text>
            <text class="caption" if="{{ organizer.detail.kind === 'projects' }}">里程碑 {{ organizer.detail.progress }}</text>
            <text class="sectionTitle" if="{{ organizer.detail.kind === 'projects' }}">下一步</text>
            <text class="detailBody" if="{{ organizer.detail.kind === 'projects' }}">{{ organizer.detail.next }}</text>
          </div>
          <div class="secondaryButton {{ taskMutationStatus === '正在同步…' ? 'sendingButton' : '' }}" if="{{ organizer.detail.kind === 'tasks' && organizer.detail.version !== undefined }}" onclick="toggleTask">
<text class="buttonText">{{ taskMutationStatus === '正在同步…' ? '正在同步…' : organizer.detail.completed ? '标记为未完成' : '勾选完成' }}</text>
</div>
<text class="notice" if="{{ taskMutationStatus }}">{{ taskMutationStatus }}</text>
<text class="sectionTitle" if="{{ organizer.detail.kind === 'projects' }}">里程碑</text>
          <div class="row {{ vm.compact ? 'compactRow' : '' }} {{ $item.completed ? 'selected' : '' }}" for="{{ organizer.milestones }}" onclick="openItem($item.kind, $item.id)">
            <div class="taskMarker {{ $item.completed ? 'taskMarkerDone' : '' }}">
              <div class="check" if="{{ $item.completed }}"></div>
            </div>
            <div class="copy">
              <text class="rowTitle">{{ $item.title }}</text>
              <text class="rowHint" if="{{ !vm.compact }}">{{ $item.subtitle }}</text>
            </div>
            <text class="chevron">›</text>
          </div>
          <text class="sectionTitle" if="{{ organizer.detail.kind === 'tasks' || organizer.detail.kind === 'schedules' || organizer.detail.kind === 'projects' }}">{{ organizer.detail.kind === 'tasks' ? '一级子任务' : '关联任务' }}</text>
          <div class="row {{ vm.compact ? 'compactRow' : '' }} {{ $item.completed ? 'selected' : '' }}" for="{{ organizer.related }}" onclick="openItem($item.kind, $item.id)">
            <div class="taskMarker {{ $item.completed ? 'taskMarkerDone' : '' }}">
              <div class="check" if="{{ $item.completed }}"></div>
            </div>
            <div class="copy">
              <text class="rowTitle">{{ $item.title }}</text>
              <text class="rowHint" if="{{ !vm.compact }}">{{ $item.subtitle }}</text>
            </div>
            <text class="chevron">›</text>
          </div>
          <div class="secondaryButton" onclick="closeDetail">
            <text class="buttonText">返回列表</text>
          </div>
        </div>
        <div class="block">
          <text class="provenance">{{ vm.provenance }}</text>
          <text class="caption">{{ organizer.coverage }}</text>
          <text class="notice" if="{{ organizer.partial }}">部分数据 · 完整记录请在手机查看</text>
          <text class="caption">{{ vm.syncLabel }}</text>
        </div>
      </div>
    </scroll>
  </div>
</template>
<script>
const pages = require('../../services/page')
export default pages.createPage('projects')
</script>
<style>
@import "../../common/wear.css";
</style>
