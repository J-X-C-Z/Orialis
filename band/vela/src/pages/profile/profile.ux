<template>
<div class="screen {{ motionClass }}" @swipe="handleSwipe" @touchstart="touchStart" @touchmove="touchMove" @touchend="touchEnd"><scroll class="content" scroll-y="true"><div class="stack"><div class="header"><div class="back" onclick="goBack"><text class="backText">‹</text></div><text class="title">{{ editor ? '编辑' : selection ? '详情' : pageTitle }}</text><text class="source">{{ vm.sourceShort }}</text></div><text if="{{ notice }}" class="notice">{{ notice }}</text><div class="card"><div class="cardHead"><div class="glyphCircle blue"><div class="glyph gearGlyph"><div class="gearCore"></div></div></div><text class="cardTitle">{{ organizer.profile.displayName || '尚未同步账户' }}</text></div><text class="meta">{{ organizer.profile.signedIn ? '手机已登录' : '登录状态待确认' }}</text><text class="meta">{{ organizer.profile.serverLabel || '服务器资料待同步' }}</text></div><div class="row" onclick="phoneAccount"><div class="copy"><text class="rowTitle">账户</text><text class="rowHint">登录 · 注册 · 退出，在手机处理</text></div><text class="chevron">›</text></div><div class="row" onclick="phoneSync"><div class="copy"><text class="rowTitle">同步与服务器</text><text class="rowHint">{{ organizer.sync.status || '同步状态未知' }}</text></div><text class="chevron">›</text></div><text class="meta" if="{{ organizer.sync.lastSyncAt }}">{{ organizer.sync.lastSyncAt }}</text><div class="row" onclick="phoneAppearance"><div class="copy"><text class="rowTitle">外观与性能</text><text class="rowHint">跟随手机设置</text></div><text class="chevron">›</text></div><div class="row" onclick="phoneSecurity"><div class="copy"><text class="rowTitle">设备中心与配对</text><text class="rowHint">确认 · 拒绝 · 撤销 · 切换，在手机处理</text></div><text class="chevron">›</text></div><div class="row" onclick="devices"><div class="copy"><text class="rowTitle">设备状态</text><text class="rowHint">手机确认的目标设备</text></div><text class="chevron">›</text></div><div class="row" onclick="settings"><div class="copy"><text class="rowTitle">手环设置与连接</text><text class="rowHint">紧凑列表 · 演示 · 连接诊断</text></div><text class="chevron">›</text></div><div class="row" onclick="commands"><div class="copy"><text class="rowTitle">快捷指令</text><text class="rowHint">仅状态预览 · 操作待接入</text></div><text class="chevron">›</text></div><div class="disabled" onclick="toggleDemo"><text class="controlText">{{ vm.demo ? '关闭演示数据' : '查看演示数据' }}</text></div><div class="block"><text class="provenance">{{ vm.provenance }}</text><text class="meta">{{ organizer.coverage }}</text><text class="notice" if="{{ organizer.partial }}">部分数据 · 完整记录请在手机查看</text><text class="meta">{{ vm.syncLabel }}</text></div></div></scroll></div>
</template>
<script>
const pages = require('../../services/page')
export default pages.createPage('profile')
</script>
<style>
@import "../../common/wear.css";
</style>
