<template>
<div class="screen {{ motionClass }}" @swipe="handleSwipe" @touchstart="touchStart" @touchmove="touchMove" @touchend="touchEnd">
<scroll class="content" scroll-y="true"><div class="stack">
<div class="header"><div class="back" onclick="goBack"><text class="backText">‹</text></div><text class="title">{{ selection ? '详情' : '日历' }}</text></div>
<text if="{{ notice }}" class="notice">{{ notice }}</text>
<div class="stack calendarStack" if="{{ !selection }}">
<div class="calendarDateBlock"><div class="calendarDateLine"><text class="calendarDateTitle">{{ calendarDateLabel }}</text><text class="calendarTodayBadge" if="{{ calendarIsToday }}">今日</text></div><text class="calendarWeekday" if="{{ calendarWeekday }}">{{ calendarWeekday }}</text></div>
<div class="calendarControls" if="{{ organizer.date }}"><div class="calendarDateButton" onclick="prevDate"><text class="calendarControlText">前一天</text></div><div class="calendarDateButton calendarTodayButton" onclick="todayDate"><text class="calendarControlText">今天</text></div><div class="calendarDateButton" onclick="nextDate"><text class="calendarControlText">后一天</text></div></div>
<text class="calendarSummary" if="{{ organizer.available }}">{{ organizer.scheduleRows.length }} 项日程 · {{ organizer.rows.length }} 项截止任务</text>
<div class="calendarEmpty" if="{{ !calendarTotal }}"><text class="calendarEmptyTitle">{{ organizer.available ? '这一天暂无安排' : '连接后查看日程' }}</text><text class="calendarEmptyBody">{{ organizer.available ? '换一天看看，或在手机添加。' : '请在手机连接手环并同步。' }}</text></div>
<text class="calendarSection" if="{{ visibleScheduleRows.length }}">日程</text>
<div class="calendarRow" for="{{ visibleScheduleRows }}" onclick="openItem($item.kind, $item.id)"><div class="calendarAccent nextTone"></div><div class="copy"><text class="calendarTime">{{ $item.subtitle }}</text><text class="calendarItemTitle">{{ $item.title }}</text></div><text class="calendarChevron">›</text></div>
<text class="calendarSection" if="{{ visibleRows.length }}">截止任务</text>
<div class="calendarRow" for="{{ visibleRows }}" onclick="openItem($item.kind, $item.id)"><div class="calendarAccent dueTone"></div><div class="copy"><text class="calendarItemTitle">{{ $item.title }}</text><text class="rowHint">{{ $item.subtitle }}</text></div><text class="calendarChevron">›</text></div>
<div class="disabled" if="{{ hasMore }}" onclick="showMore"><text class="buttonText">显示更多 · 余 {{ calendarTotal - visibleScheduleRows.length - visibleRows.length }} 项</text></div>
</div>
<div class="stack" if="{{ selection && organizer.detail }}"><div class="card"><text class="calendarDetailTitle">{{ organizer.detail.displayTitle }}</text><text class="stateBadge">{{ organizer.detail.statusLabel }}</text><text class="meta" if="{{ organizer.detail.due }}">截止 {{ organizer.detail.due }}</text><text class="emptyBody" if="{{ organizer.detail.notes }}">{{ organizer.detail.notes }}</text><text class="emptyBody" if="{{ organizer.detail.description }}">{{ organizer.detail.description }}</text><text class="emptyBody" if="{{ organizer.detail.goal }}">{{ organizer.detail.goal }}</text><text class="meta" if="{{ organizer.detail.when }}">{{ organizer.detail.when }}</text><text class="meta" if="{{ organizer.detail.location }}">{{ organizer.detail.location }}</text><text class="meta" if="{{ organizer.detail.kind === 'tasks' || organizer.detail.kind === 'schedules' }}">提前提醒 {{ organizer.detail.reminderMinutes === null || organizer.detail.reminderMinutes === undefined ? '未设置' : organizer.detail.reminderMinutes + '分钟' }}</text><text class="meta" if="{{ organizer.detail.kind === 'tasks' || organizer.detail.kind === 'schedules' }}">通知送达待接入</text><text class="meta" if="{{ organizer.detail.recurrence }}">已有重复规则 · 在手机编辑</text><text class="meta" if="{{ organizer.detail.kind === 'projects' }}">里程碑 {{ organizer.detail.progress }}</text><text class="body" if="{{ organizer.detail.kind === 'projects' }}">下一步 {{ organizer.detail.next }}</text></div>


<text class="label" if="{{ organizer.detail.kind === 'projects' }}">里程碑</text><div class="row {{ $item.completed ? 'selected' : '' }}" for="{{ organizer.milestones }}" onclick="openItem($item.kind, $item.id)"><div class="copy"><text class="rowTitle">{{ $item.title }}</text><text class="rowHint">{{ $item.subtitle }}</text></div><text class="chevron">›</text></div><text class="label" if="{{ organizer.detail.kind === 'tasks' || organizer.detail.kind === 'schedules' || organizer.detail.kind === 'projects' }}">{{ organizer.detail.kind === 'tasks' ? '一级子任务' : '关联任务' }}</text><div class="row {{ $item.completed ? 'selected' : '' }}" for="{{ organizer.related }}" onclick="openItem($item.kind, $item.id)"><div class="copy"><text class="rowTitle">{{ $item.title }}</text><text class="rowHint">{{ $item.subtitle }}</text></div><text class="chevron">›</text></div>
<div class="disabled" onclick="closeDetail"><text class="buttonText">返回列表</text></div></div>
<div class="calendarFooter"><text class="calendarSource">{{ vm.sourceShort }} · 仅查看</text><text class="calendarFootnote">{{ vm.syncLabel }}</text><text class="notice" if="{{ organizer.partial }}">部分数据 · 完整记录请在手机查看</text></div>
</div></scroll></div>
</template>
<script>
const pages = require('../../services/page')
export default pages.createPage('calendar')
</script>
<style>
@import "../../common/wear.css";
</style>
