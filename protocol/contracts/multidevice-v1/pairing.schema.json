{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orialis.example/contracts/multidevice-v1/pairing.schema.json",
  "title": "Orialis Node Pairing v1",
  "oneOf": [
    {
      "$ref": "#/$defs/startResponse"
    },
    {
      "$ref": "#/$defs/confirmRequest"
    },
    {
      "$ref": "#/$defs/confirmResponse"
    },
    {
      "$ref": "#/$defs/completeRequest"
    },
    {
      "$ref": "#/$defs/completeResponse"
    },
    {
      "$ref": "#/$defs/failuresDocument"
    }
  ],
  "$defs": {
    "startResponse": {
      "type": "object",
      "required": [
        "protocolVersion",
        "pairingId",
        "pairingSecret",
        "confirmationCode",
        "targetNode",
        "expiresAt"
      ],
      "properties": {
        "protocolVersion": {
          "const": "1"
        },
        "pairingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "pairingSecret": {
          "type": "string",
          "minLength": 32,
          "maxLength": 512
        },
        "confirmationCode": {
          "type": "string",
          "pattern": "^[0-9]{6}$"
        },
        "targetNode": {
          "$ref": "#/$defs/nodeIdentity"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "confirmRequest": {
      "type": "object",
      "required": [
        "confirmationCode",
        "decision"
      ],
      "properties": {
        "confirmationCode": {
          "type": "string",
          "pattern": "^[0-9]{6}$"
        },
        "decision": {
          "enum": [
            "confirm",
            "reject"
          ]
        }
      },
      "additionalProperties": false
    },
    "confirmResponse": {
      "type": "object",
      "required": [
        "protocolVersion",
        "pairingId",
        "status",
        "accountId",
        "expiresAt"
      ],
      "properties": {
        "protocolVersion": {
          "const": "1"
        },
        "pairingId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "confirmed",
            "rejected"
          ]
        },
        "accountId": {
          "type": "string",
          "minLength": 1
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "completeRequest": {
      "type": "object",
      "required": [
        "pairingSecret",
        "nodeIdentity"
      ],
      "properties": {
        "pairingSecret": {
          "type": "string",
          "minLength": 32,
          "maxLength": 512
        },
        "nodeIdentity": {
          "$ref": "#/$defs/nodeIdentity"
        }
      },
      "additionalProperties": false
    },
    "completeResponse": {
      "type": "object",
      "required": [
        "protocolVersion",
        "deviceId",
        "accountId",
        "deviceCredential"
      ],
      "properties": {
        "protocolVersion": {
          "const": "1"
        },
        "deviceId": {
          "type": "string",
          "minLength": 1
        },
        "accountId": {
          "type": "string",
          "minLength": 1
        },
        "deviceCredential": {
          "type": "string",
          "minLength": 32,
          "maxLength": 512
        }
      },
      "additionalProperties": false
    },
    "failureCase": {
      "type": "object",
      "required": [
        "case",
        "httpStatus",
        "errorCode",
        "stateAfter"
      ],
      "properties": {
        "case": {
          "type": "string",
          "minLength": 1
        },
        "httpStatus": {
          "type": "integer",
          "minimum": 200,
          "maximum": 599
        },
        "errorCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "stateAfter": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "failuresDocument": {
      "type": "object",
      "required": [
        "failures"
      ],
      "properties": {
        "failures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/failureCase"
          }
        }
      },
      "additionalProperties": false
    },
    "nodeIdentity": {
      "type": "object",
      "required": [
        "displayName",
        "platform",
        "nodeVersion"
      ],
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "nodeVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "additionalProperties": false
    }
  }
}
