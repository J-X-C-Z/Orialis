{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orialis.example/contracts/domain/message-v1.schema.json",
  "title": "Orialis Message v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "conversationId", "role", "content", "createdAt", "version", "attachments"],
  "properties": {
    "id": {"$ref": "./common.schema.json#/$defs/entityId"},
    "conversationId": {"$ref": "./common.schema.json#/$defs/entityId"},
    "role": {"type": "string", "minLength": 1},
    "content": {"type": "string"},
    "createdAt": {"$ref": "./common.schema.json#/$defs/timestamp"},
    "version": {"type": "integer", "minimum": 1},
    "attachments": {"type": "array", "items": {"$ref": "attachment.schema.json"}}
  }
}
