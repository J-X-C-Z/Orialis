{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orialis.example/contracts/agent-gateway/schema-v1.schema.json",
  "title": "Orialis Agent Gateway v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "type"],
  "properties": {
    "version": {"const": 1},
    "type": {"type": "string", "minLength": 1},
    "device_id": {"type": "string", "minLength": 1},
    "client": {"type": "string", "minLength": 1},
    "plugin_version": {"type": "string", "minLength": 1},
    "platform": {"type": "string", "minLength": 1},
    "message_id": {"type": "string", "minLength": 1},
    "reply_to": {"type": "string", "minLength": 1},
    "conversation_id": {"type": "string", "minLength": 1},
    "content": {"type": "string"},
    "attachments": {"type": "array", "items": {"$ref": "#/definitions/attachment"}},
    "status": {"type": "string", "minLength": 1},
    "code": {"type": "string", "minLength": 1},
    "message": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 1},
    "seq": {"type": "integer", "minimum": 0},
    "expected_seq": {"type": "integer", "minimum": 1},
    "capabilities": {"type": "array", "items": {"type": "string"}},
    "resume_from": {"type": "integer", "minimum": 0},
    "next_seq": {"type": "integer", "minimum": 0}
  },
  "definitions": {
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "mime_type", "size", "download_url"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "mime_type": {"type": "string", "minLength": 1},
        "size": {"type": "integer", "minimum": 0},
        "download_url": {"type": "string", "format": "uri"}
      }
    }
  }
}
