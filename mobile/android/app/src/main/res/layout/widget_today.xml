<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
    <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#B8C4D7" android:textSize="12sp" android:maxLines="1" />
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textColor="#FFFFFF" android:textSize="19sp" android:textStyle="bold"
        android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/widget_lines" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:textColor="#E1E7F0" android:textSize="14sp" android:maxLines="5"
        android:ellipsize="end" android:lineSpacingExtra="4dp" />
</LinearLayout>
