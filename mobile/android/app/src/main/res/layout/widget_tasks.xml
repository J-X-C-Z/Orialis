<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="任务列表" android:textColor="@color/widget_on_surface" android:textSize="18sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Orialis · 每一天，从容安排" android:textColor="@color/widget_secondary" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:layout_width="28dp" android:layout_height="28dp" android:gravity="center"
            android:background="@drawable/widget_accent_background" android:text="↗" android:textColor="@color/widget_on_accent" android:textSize="16sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_metric_group" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="bottom" android:visibility="gone">
        <TextView android:id="@+id/widget_metric" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="3" android:textSize="32sp" android:textStyle="bold" android:textColor="@color/widget_on_surface" />
        <TextView android:id="@+id/widget_summary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="6dp" android:layout_marginBottom="6dp" android:text="项待完成"
            android:textSize="11sp" android:textColor="@color/widget_secondary" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_rows" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="8dp" android:orientation="vertical">
        <include layout="@layout/widget_item" />
        <include layout="@layout/widget_item" />
    </LinearLayout>
    <TextView android:id="@+id/widget_footer" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="打开 Orialis  ↗" android:textSize="11sp"
        android:visibility="gone" android:layout_marginTop="4dp" android:maxLines="1"
        android:ellipsize="end" android:textColor="@color/widget_secondary" />
</LinearLayout>
