<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="3dp" android:left="1dp">
        <shape><solid android:color="@color/widget_shadow_soft" /><corners android:radius="@dimen/widget_radius_card" /></shape>
    </item>
    <item android:top="2dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
        <shape><solid android:color="@color/widget_shadow" /><corners android:radius="@dimen/widget_radius_card" /></shape>
    </item>
    <item android:right="1dp" android:bottom="3dp">
        <shape>
            <gradient android:angle="315" android:startColor="@color/widget_surface_high" android:centerColor="@color/widget_surface" android:endColor="@color/widget_surface_low" />
            <stroke android:width="0.5dp" android:color="@color/widget_highlight" />
            <corners android:radius="@dimen/widget_radius_card" />
        </shape>
    </item>
</layer-list>
