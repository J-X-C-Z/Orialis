{
  "name": "@orialis/lumina-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && tsc -p tsconfig.lib.json && vite build && vite build --config vite.lib.config.ts",
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/fiber": "^9.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  },
  "exports": {
    ".": {
      "import": "./lib-dist/index.js"
    },
    "./style.css": "./lib-dist/index.css"
  },
  "types": "./types/index.d.ts"
