# Replace example domains before starting the service.
ORIALIS_API_URL=https://orialis.example.com
ORIALIS_MCP_PUBLIC_URL=https://mcp.orialis.example.com
ORIALIS_MCP_DATABASE=/var/lib/orialis-mcp/mcp.sqlite
ORIALIS_MCP_HOST=127.0.0.1
ORIALIS_MCP_PORT=18444

# HTTP OAuth determines user scopes interactively. These variables apply to stdio.
# Do not place a real session token in this shared example file.
# ORIALIS_SESSION_TOKEN=
ORIALIS_MCP_SCOPES=orialis:read
