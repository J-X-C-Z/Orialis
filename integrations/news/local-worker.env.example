# Local Paperclip process worker runtime. Do not overwrite Codex login or global settings.
# Use the existing login of the macOS user running this worker; no model override.
ORIALIS_NEWS_RUNNER_COMMAND='/Users/jxcz/.local/bin/codex exec --ephemeral --sandbox read-only --skip-git-repo-check --json -'
# Bounded model-call timeout; process adapter timeout should be at least 900 seconds.
ORIALIS_NEWS_RUNNER_TIMEOUT='540'
# Point at the reviewed Orialis service before a publish run.
ORIALIS_NEWS_BASE_URL='http://127.0.0.1:18443/api/v1/news'
ORIALIS_NEWS_DB='/Users/jxcz/.local/share/orialis-news/pipeline.sqlite3'
ORIALIS_NEWS_REFRESH_STATE='/Users/jxcz/.cache/orialis-news/refresh-state.json'
# Provide ORIALIS_NEWS_PUBLISHER_TOKEN and ORIALIS_NEWS_PUBLISHER_USER_ID
# through the worker's private environment, never in this example or source control.
# AIHot: python3 scripts/news_sources.py --refresh aihot
# GitHub: python3 -m integrations.news.cli github daily --publish --task-id <stable-run-id>
# GitHub: python3 -m integrations.news.cli github weekly --publish --task-id <stable-run-id>
# Run the worker with repo/ as cwd. Omit --publish for collection/analysis-only validation.
# Paperclip wrapper scope: use reviewed identifiers from the target company/project.
# The process adapter supplies its run-scoped PAPERCLIP_API_URL/API_KEY/RUN_ID.
# ORIALIS_NEWS_PAPERCLIP_COMPANY_ID='<reviewed-company-id>'
# ORIALIS_NEWS_PAPERCLIP_PROJECT_ID='<reviewed-news-project-id>'
# ORIALIS_NEWS_AIHOT_ROUTINE_ID='<reviewed-aihot-routine-id>'
# ORIALIS_NEWS_GITHUB_DAILY_ROUTINE_ID='<reviewed-daily-routine-id>'
# ORIALIS_NEWS_GITHUB_WEEKLY_ROUTINE_ID='<reviewed-weekly-routine-id>'
# Process argv: -m integrations.news.worker --workflow aihot
# Process argv: -m integrations.news.worker --workflow github
# A successful durable receipt is followed by issue=done; failures are blocked.
# Recovery reuses confirmed publication; unknown interrupted work stays blocked.
