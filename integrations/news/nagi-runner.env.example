# Load this variable only in the Nagi Paperclip worker invocation/environment.
# Run the worker as JXCZ so Codex CLI reuses the existing ~/.codex ChatGPT login.
# This file intentionally contains no credentials and does not set CODEX_HOME.
ORIALIS_NEWS_RUNNER_COMMAND='/home/JXCZ/.local/bin/codex exec --ephemeral --sandbox read-only --skip-git-repo-check --json -'
