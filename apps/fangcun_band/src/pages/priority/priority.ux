import link from "../../utils/interconnect.js"
import { snapshotTasks } from "../../utils/snapshot.js"

function priorityGroups(tasks) {
  const definitions = [
    { color: "red", important: true, urgent: true, importantLabel: "重要", urgentLabel: "紧急" },
    { color: "yellow", important: false, urgent: true, importantLabel: "不重要", urgentLabel: "紧急" },
    { color: "blue", important: true, urgent: false, importantLabel: "重要", urgentLabel: "不紧急" },
    { color: "green", important: false, urgent: false, importantLabel: "不重要", urgentLabel: "不紧急" }
  ]
  return definitions.map(definition => {
    const groupTasks = tasks.filter(task => !!task.important === definition.important && !!task.urgent === definition.urgent)
    return Object.assign({}, definition, { tasks: groupTasks, count: groupTasks.length })
  }).filter(group => group.count)
}

export default {
  private: {
    motionClass: "enter-right",
    emptyText: "",
    groups: []
  },
  onShow() {
    this.updateSnapshot(link.getSnapshot())
    this.stopLinkListener = link.on((event, snapshot) => {
      if (event === "snapshot") this.updateSnapshot(snapshot)
    })
  },
  onHide() {
    if (this.stopLinkListener) this.stopLinkListener()
    this.stopLinkListener = null
  },
  updateSnapshot(snapshot) {
    const items = snapshot && snapshot.payload && snapshot.payload.tasks && snapshot.payload.tasks.items
    if (!Array.isArray(items)) return
    const tasks = snapshotTasks(snapshot, 20)
    this.groups = priorityGroups(tasks)
    this.emptyText = tasks.length ? "" : "暂无优先级任务"
  },
  toggleTask(id) {
    this.groups.forEach(group => group.tasks.forEach(task => {
      if (task.id === id) {
        const wasCompleted = task.completed
        task.completed = !task.completed
        link.sendAction({ action: "setCompleted", taskId: id, completed: task.completed, at: new Date().toISOString() }).catch(() => {})
        if (!wasCompleted && task.completed) haptic.complete()
      }
    }))
  },
