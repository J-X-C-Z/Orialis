ORIALIS_ENV=production
ORIALIS_HOST=127.0.0.1
ORIALIS_PORT=18443
ORIALIS_PUBLIC_URL=https://orialis.jxcz.top
ORIALIS_DATABASE_URL=sqlite:///var/lib/orialis/orialis.db?mode=rwc
ORIALIS_UPLOAD_DIR=/var/lib/orialis/uploads
# Local-only device identity mode; keep false in production.
ORIALIS_DEV_DEVICE_AUTH=false
# Shared secret for the Hermes Agent Gateway; generate and store this outside Git.
# ORIALIS_AGENT_DEVICE_TOKEN=replace-with-a-long-random-secret
# Optional when the database contains more than one user. With one user the
# server binds Agent devices to that account automatically.
# ORIALIS_AGENT_USER_ID=owner-user-id
# News publishing uses a separate secret and a fixed existing Orialis user.
# Set the same dedicated random token in the publisher worker environment.
# ORIALIS_NEWS_PUBLISHER_TOKEN=replace-with-a-different-long-random-secret
# ORIALIS_NEWS_PUBLISHER_USER_ID=existing-user-id
RUST_LOG=orialis_server=info
