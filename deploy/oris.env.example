ORIS_ENV=production
ORIS_HOST=127.0.0.1
ORIS_PORT=18443
ORIS_PUBLIC_URL=https://orialis.jxcz.top
ORIS_DATABASE_URL=sqlite:///var/lib/oris/oris.db?mode=rwc
# Local-only device identity mode; keep false in production.
ORIS_DEV_DEVICE_AUTH=false
# Shared secret for the Hermes Agent Gateway; generate and store this outside Git.
# ORIS_AGENT_DEVICE_TOKEN=replace-with-a-long-random-secret
RUST_LOG=oris_server=info
