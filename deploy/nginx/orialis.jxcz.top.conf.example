# Orialis API reverse proxy template.
# Install after DNS points orialis.jxcz.top to this server and a TLS certificate exists.

server {
    listen 80;
    listen [::]:80;
    server_name orialis.jxcz.top;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name orialis.jxcz.top;

    ssl_certificate /etc/letsencrypt/live/orialis.jxcz.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/orialis.jxcz.top/privkey.pem;

    client_max_body_size 2m;

    # Keep the Agent Gateway upgrade explicit; the Hermes plugin uses a long-lived connection.
    location /api/v1/agent/ws {
        proxy_pass http://127.0.0.1:18443;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_buffering off;
    }

    # The mobile client keeps a user-scoped realtime connection for sync hints
    # and assistant messages. It needs the same WebSocket upgrade handling.
    location ~ ^/api/v1/(mobile/)?ws$ {
        proxy_pass http://127.0.0.1:18443;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_buffering off;
    }

    location / {
        proxy_pass http://127.0.0.1:18443;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
    }
}
